{
    "required": true,
    "minVersion": "0.8",
    "package": "ua.bonfiremc.improvedtooltips.mixin",
    "compatibilityLevel": "JAVA_${java_version}",
    "client": [
        "TooltipColorMixin", "TooltipRenderUtilMixin"
    ],
    "injectors": {
        "defaultRequire": 1
    },
    "overwrites": {
        "requireAnnotations": true
    },
    "mixins": [ "ItemStackMixin", "hide_tooltips.HangingEntityItemMixin", "hide_tooltips.PotionContentsMixin", ${extra_mixins} ]
}
